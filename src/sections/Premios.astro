---
import Box from "../components/Box.astro";
import Button from "../components/Button.astro";
---

<section id="premios" class="lg:w-[60vw] lg:ms-[39vw] py-20 px-10">
  <Box>
    <h2>Participación abierta para:</h2>
    <ul class="mb-4 before:content-['...'] before:block">
      <li>Jóvenes de entre 18 y 30 años</li>
      <li>Estudiantes de FP que tengan interés en emprender</li>
      <li>
        Personas jóvenes hayan o no finalizado sus estudios con grandes ideas
        emprendedoras
      </li>
    </ul>
    <p class="mb-4">¡Es un programa totalmente gratuito!</p>
    <h2 class="mb-4">Premios:</h2>
    <details class="cursor-pointer" name="premios">
      <summary>Categoría <strong>Economía Social</strong></summary>
      <ul class="mb-4 list-disc ps-8">
        <li>Primer premio: 1.200 euros en metálico.</li>
        <li>Segundo premio: 600 euros en metálico.</li>
      </ul>
    </details>

    <details class="cursor-pointer mb-4" name="premios">
      <summary>Categoría <strong>Sinergia</strong></summary>
      <ul class="mb-4 list-disc ps-8">
        <li>
          Primer premio: Tarjeta regalo de 200 € para cada miembro del equipo
          ganador y para el/la docente que los haya acompañado.
        </li>
        <li>
          Segundo premio: Tarjeta regalo de 100 € para cada miembro del equipo
          finalista y para el/la docente que los haya acompañado.
        </li>
      </ul>
    </details>
	
    <!-- <Button
      href="/descargas/Bases-Premio-Avanza-Joven-2027.pdf"
      text="Conoce las bases de los premios"
      blank
    /> -->

	<div class="flex items-stretch gap-2 mt-auto">
	  <a
		href="/descargas/Bases-Premio-Avanza-Joven-2027.pdf"
		class="inline-block border border-emerald-950 bg-emerald-950 p-4"
		target="_blank"
		rel="noopener"
		title="Abrir PDF"
	  >
		Conoce las bases de los premios
	  </a>

	  <a
		href="/descargas/Bases-Premio-Avanza-Joven-2027.pdf"
		download="Bases-Premio-Avanza-Joven-2027.pdf"
		class="flex aspect-square items-center justify-center border border-emerald-950 bg-emerald-950 text-white"
		title="Descargar PDF"
		aria-label="Descargar PDF"
		style="color:#fafafa!important; padding: 0 14px;"
	  >
		<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		  <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
		  <path d="M7 11l5 5l5 -5" />
		  <path d="M12 4l0 12" />
		</svg>
	  </a>
	</div>

  </Box>
</section>
